# PostgreSQL (required — source of truth)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/amwaj_pos?schema=public"

# Example local:
# DATABASE_URL="postgresql://amwaj:amwaj123@localhost:5432/amwaj_pos?schema=public"

# Example Render / Neon / Supabase:
# DATABASE_URL="postgresql://user:pass@host:5432/amwaj_pos?sslmode=require"

# REQUIRED in production: long random string (min 32 chars). Generate e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
# Session length (default 30 days). Examples: 7d, 30d, 90d
JWT_EXPIRES="30d"
PORT=4000
# Must match the browser origin that serves the SPA
FRONTEND_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Seed only (never use these defaults in production without changing them)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="amwaj2024"
SEED_ADMIN_NAME="Amwaj Owner"
